{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unit_file_v1.json",
  "title": "AIze Unit Descriptor",
  "type": "object",
  "required": ["launcher"],
  "properties": {
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_kind": {
      "type": "string"
    },
    "unit_class": {
      "type": "string"
    },
    "instance_policy": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string"
    },
    "restart_policy": {
      "type": "string"
    },
    "interfaces": {
      "type": "object"
    },
    "endpoints": {
      "type": "object"
    },
    "communication": {
      "type": "object"
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "launcher": {
      "type": "object",
      "properties": {
        "create_as_child": {
          "type": "boolean"
        },
        "default_label": {
          "type": "string"
        },
        "parent_unit_id": {
          "type": "string"
        },
        "parent_template_id": {
          "type": "string"
        },
        "resident_parent_session_id": {
          "type": "string"
        },
        "goal_text": {
          "type": "string"
        },
        "initial_prompt": {
          "type": "string"
        },
        "preferred_provider": {
          "type": "string",
          "enum": ["codex", "claude", "gemini"]
        },
        "selected_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_group": {
          "type": "string",
          "enum": ["root", "user", "error"]
        },
        "session_ui_mode": {
          "type": "string",
          "enum": ["standard", "map_only", "communication"]
        },
        "session_interactive": {
          "type": "boolean"
        },
        "communication_agent_enabled": {
          "type": "boolean"
        },
        "communication_agent_priority": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        "session_permissions": {
          "type": "object"
        },
        "child_session_sharing": {
          "type": "object"
        },
        "workspace_scope": {
          "type": "string",
          "enum": ["none", "unit", "app"]
        },
        "auto_select_session": {
          "type": "boolean"
        },
        "auto_send_initial_prompt": {
          "type": "boolean"
        },
        "schedule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "enum": ["daily", "interval"]
            },
            "timezone": {
              "type": "string"
            },
            "daily_time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "every_hours": {
              "type": "integer",
              "minimum": 1
            },
            "interval_hours": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
